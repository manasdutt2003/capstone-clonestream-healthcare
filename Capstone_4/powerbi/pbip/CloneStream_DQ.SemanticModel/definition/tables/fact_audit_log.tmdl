	partition 'fact_audit_log-csv' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(CsvFolder & "\fact_audit_log.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Promoted, {{"run_id", type text}, {"job", type text}, {"git_sha", type text}, {"seconds", type number}, {"status", type text}, {"rows_in", Int64.Type}, {"rows_out", type number}, {"rules_run", type number}, {"rules_failed", type number}, {"rules_passed", type number}, {"outputs_digest", type text}, {"output_files", Int64.Type}}, "en-US"),
			    Dt0 = Table.TransformColumns(Typed, {{"started_utc", each try DateTimeZone.RemoveZone(DateTimeZone.FromText(_)) otherwise null, type nullable datetime}}),
			    Dt1 = Table.TransformColumns(Dt0, {{"ended_utc", each try DateTimeZone.RemoveZone(DateTimeZone.FromText(_)) otherwise null, type nullable datetime}})
			in
			    Dt1
